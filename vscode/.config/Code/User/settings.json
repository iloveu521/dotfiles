{
  "window.zoomLevel": 1,
  "settingsSync.ignoredExtensions": [],
  "settingsSync.ignoredSettings": [],
  "stm32-for-vscode.openOCDPath": false,
  "stm32-for-vscode.makePath": "/usr/bin/make",
  "stm32-for-vscode.armToolchainPath": false,
  "editor.accessibilityPageSize": 12,
  "editor.fontLigatures": true,
  "editor.fontFamily": "'Fira Code', 'JetBrains Mono', 'Cascadia Code', monospace",
  "editor.fontSize": 15,
  "editor.letterSpacing": 0.5,
  "editor.lineHeight": 1.4,
  "editor.formatOnType": true,
  "editor.formatOnPaste": true,
  "editor.formatOnSave": true,
  "vim.useSystemClipboard": true,
  "vim.insertModeKeyBindings": [
    {
      "before": ["j", "k"],
      "after": ["<Esc>"]
    }
  ],
  "vim.normalModeKeyBindings": [
    {
      "before": [
        "K"
      ],
      "commands": [
        "editor.action.showHover"
      ]
    },
    {
      "before": [
        "<C-h>"
      ],
      "commands": [
        "workbench.action.focusLeftGroup"
      ]
    },
    {
      "before": [
        "<C-j>"
      ],
      "commands": [
        "workbench.action.focusBelowGroup"
      ]
    },
    {
      "before": [
        "<C-k>"
      ],
      "commands": [
        "workbench.action.focusAboveGroup"
      ]
    },
    {
      "before": [
        "<C-l>"
      ],
      "commands": [
        "workbench.action.focusRightGroup"
      ]
    },
    {
      "before": [
        "g",
        "D"
      ],
      "commands": [
        "editor.action.goToDeclaration"
      ]
    },
    {
      "before": [
        "g",
        "r"
      ],
      "commands": [
        "editor.action.goToReferences"
      ]
    }
  ],
  "editor.mouseWheelZoom": true,
  "editor.defaultFormatter": "xaver.clang-format",
  "[cpp]": {
    "editor.defaultFormatter": "xaver.clang-format",
    "editor.tabSize": 2,
    "editor.insertSpaces": true
  },
  "[c]": {
    "editor.defaultFormatter": "xaver.clang-format",
    "editor.tabSize": 2,
    "editor.insertSpaces": true
  },
  "[python]": {
    "editor.defaultFormatter": "ms-python.black-formatter",
    "editor.formatOnSave": true
  },
  "[json]": {
    "editor.defaultFormatter": "vscode.json-language-features"
  },
  "clang-format.style": "Google",
  "clang-format.executable": "/usr/bin/clang-format",
  "redhat.telemetry.enabled": true,
  "security.workspace.trust.untrustedFiles": "open",
  "cmake.showOptionsMovedNotification": false,
  "cmake.options.statusBarVisibility": "visible",
  "cmake.showConfigureWithDebuggerNotification": false,
  "html.format.contentUnformatted": "",
  "terminal.integrated.inheritEnv": false,
  "terminal.integrated.fontFamily": "'Fira Code', 'JetBrains Mono', monospace",
  "python.createEnvironment.trigger": "off",
  "explorer.confirmDelete": false,
  "files.autoSave": "afterDelay",
  "files.autoSaveDelay": 1000,
  "remote.SSH.remotePlatform": {},
  "diffEditor.renderSideBySide": true,
  "debug.onTaskErrors": "abort",
  "workbench.editor.useModal": "some",
  "chat.agentSessionsViewLocation": "single-view",
  "chat.viewSessions.orientation": "stacked",
  "chat.editor.fontSize": 16,
  "chat.fontSize": 15,
  "chat.inlineReferences.style": "link",
  "chat.unifiedAgentsBar.enabled": true,
  "claudeCode.preferredLocation": "panel",
  "claudeCode.disableLoginPrompt": true,
  "github.copilot.nextEditSuggestions.enabled": false,
  "EIDE.ARM.Option.AxfToElf": true,
  "EIDE.ARM.GCC.InstallDirectory": "${userHome}/.eide/tools/gcc_arm",
  "EIDE.JLink.InstallDirectory": "${userHome}/.eide/tools/jlink",
  "editor.tabSize": 2,
  "editor.unicodeHighlight.nonBasicASCII": false,
  "workbench.editorAssociations": {
    "*.copilotmd": "vscode.markdown.preview.editor",
    "*.md": "vscode.markdown.preview.editor"
  },
  "workbench.editor.markdownDefaultEditorInAgentsWindow": true,
  "terminal.integrated.initialHint": false,
  "workbench.editor.autoLockGroups": {
    "workbench.editor.chatSession": true,
    "agentSessionsWelcomePage": true
  },
  "workbench.iconTheme": "vscode-celestial-magic-girl-icon-theme",
  "workbench.productIconTheme": "material-product-icons",
  "workbench.commandPalette.experimental.suggestCommands": true,
  "workbench.activityBar.compact": true,
