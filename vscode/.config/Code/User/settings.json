  "editor.tokenColorCustomizations": {
    "textMateRules": [
      {
        "name": "Comments — quiet green",
        "scope": ["comment", "punctuation.definition.comment"],
        "settings": { "foreground": "#39834F" }
      },
      {
        "name": "Control and declaration keywords",
        "scope": ["keyword", "storage", "storage.type", "storage.modifier"],
        "settings": { "foreground": "#6D00D9" }
      },
      {
        "name": "Numbers and constants",
        "scope": ["constant", "constant.language", "constant.numeric", "support.constant"],
        "settings": { "foreground": "#D66A00" }
      },
      {
        "name": "Strings",
        "scope": ["string", "string.quoted", "string.template"],
        "settings": { "foreground": "#D4145A" }
      },
      {
        "name": "Functions",
        "scope": ["entity.name.function", "support.function", "meta.function-call"],
        "settings": { "foreground": "#008F78" }
      },
      {
        "name": "Types and classes",
        "scope": ["entity.name.type", "entity.name.class", "support.type", "support.class"],
        "settings": { "foreground": "#005ED9" }
      },
      {
        "name": "Variables",
        "scope": ["variable", "variable.other"],
        "settings": { "foreground": "#294D68" }
      },
      {
        "name": "Parameters",
        "scope": ["variable.parameter"],
        "settings": { "foreground": "#B0008F" }
      },
      {
        "name": "Tags and attributes",
        "scope": ["entity.name.tag", "entity.other.attribute-name"],
        "settings": { "foreground": "#D4145A" }
      },
      {
        "name": "Punctuation",
        "scope": ["punctuation", "meta.brace"],
        "settings": { "foreground": "#545B66" }
      }
    ]
  },
  "editor.semanticTokenColorCustomizations": {
    "enabled": true,
    "rules": {
      "namespace": "#3D45C9",
      "class": "#005ED9",
      "struct": "#005ED9",
      "enum": "#174CC2",
      "type": "#005ED9",
      "typeParameter": "#5435C7",
      "function": "#008F78",
      "method": "#008F78",
      "property": "#007A9E",
      "variable": "#294D68",
      "parameter": "#B0008F",
      "enumMember": "#D66A00",
      "macro": "#E00070",
      "keyword": "#6D00D9",
      "comment": "#39834F",
      "string": "#D4145A",
      "number": "#D66A00"
    }
  },
  "editor.bracketPairColorization.enabled": true,
  "editor.guides.bracketPairs": "active",
  "editor.guides.highlightActiveBracketPair": true,
  "terminal.integrated.minimumContrastRatio": 1,
  "editor.fontLigatures": true,
  "git.openRepositoryInParentFolders": "never",
  "editor.inlineSuggest.enabled": false,

  
  "newFile.defaultBaseFileName": "newFile",
  "newFile.relativeTo": "project", // "root" or "project"
  "newFile.defaultFileExtension": ".ts",
  "newFile.rootDirectory": "~",
  "newFile.showPathRelativeTo": "project", // "project" or "none"
  "newFile.expandBraces": false,
  "clangd.path": "/usr/bin/clangd" // setting to true will allow for creating multiple files such as `new-folder/{file1,file2}.js`

}
