  "editor.tokenColorCustomizations": {
    "[Light+]": {
      "textMateRules": [
        {
          "name": "Comments — muted green",
          "scope": [
            "comment",
            "punctuation.definition.comment"
          ],
          "settings": {
            "foreground": "#536B55"
          }
        },
        {
          "name": "Keywords",
          "scope": [
            "keyword",
            "storage",
            "storage.type",
            "storage.modifier"
          ],
          "settings": {
            "foreground": "#5C3F80"
          }
        },
        {
          "name": "Numbers and constants",
          "scope": [
            "constant",
            "constant.language",
            "constant.numeric",
            "support.constant"
          ],
          "settings": {
            "foreground": "#80531E"
          }
        },
        {
          "name": "Strings",
          "scope": [
            "string",
            "string.quoted",
            "string.template"
          ],
          "settings": {
            "foreground": "#8C435E"
          }
        },
        {
          "name": "Functions",
          "scope": [
            "entity.name.function",
            "support.function",
            "meta.function-call"
          ],
          "settings": {
            "foreground": "#3A6178"
          }
        },
        {
          "name": "Types and classes",
          "scope": [
            "entity.name.type",
            "entity.name.class",
            "support.type",
            "support.class"
          ],
          "settings": {
            "foreground": "#4D6B43"
          }
        },
        {
          "name": "Variables",
          "scope": [
            "variable",
            "variable.other"
          ],
          "settings": {
            "foreground": "#38333F"
          }
        },
        {
          "name": "Parameters",
          "scope": [
            "variable.parameter"
          ],
          "settings": {
            "foreground": "#70485F"
          }
        },
        {
          "name": "Tags and attributes",
          "scope": [
            "entity.name.tag",
            "entity.other.attribute-name"
          ],
          "settings": {
            "foreground": "#83405A"
          }
        },
        {
          "name": "Punctuation",
          "scope": [
            "punctuation",
            "meta.brace"
          ],
          "settings": {
            "foreground": "#514A58"
          }
        }
      ]
    },
    "[Dark+]": {
      "textMateRules": [
        {
          "name": "Comments — muted green",
          "scope": [
            "comment",
            "punctuation.definition.comment"
          ],
